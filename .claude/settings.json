{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/check.sh)",
      "Bash(scripts/check.sh *)",
      "Bash(./scripts/check.sh)",
      "Bash(./scripts/check.sh *)",
      "Bash(ktlint --format *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-kotlin.sh",
            "timeout": 30,
            "statusMessage": "Formatting Kotlin"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/konsist-on-stop.sh",
            "timeout": 300,
            "statusMessage": "Checking architecture rules"
          }
        ]
      }
    ]
  }
}
